{
  "manifest_version": 3,
  "name": "ContextGuard - AI Focus Guardian",
  "version": "1.0",
  "description": "AI-powered productivity extension that helps users stay focused.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "ContextGuard"
  }
}
